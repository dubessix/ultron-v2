{
  "manifest_version": 3,
  "name": "Ultron Browser Hands",
  "version": "1.1.0",
  "description": "Lets your own Ultron (on this PC only) list, switch, close, reload, read, sleep and reopen your tabs, and find pages in your history.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "sessions",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icon128.png"
  }
}