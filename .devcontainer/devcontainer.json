{
  "name": "Ultron Personal V1 — Ubuntu Desktop Demo",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "runArgs": [
    "--init",
    "--shm-size=1g"
  ],
  "overrideCommand": false,
  "remoteUser": "codespace",
  "containerEnv": {
    "DISPLAY": ":1",
    "ULTRON_CODESPACES_DEMO": "1"
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Ultron Ubuntu Desktop",
      "onAutoForward": "openBrowserOnce",
      "protocol": "http"
    },
    "5901": {
      "label": "Private VNC transport",
      "onAutoForward": "ignore"
    },
    "5173": {
      "label": "Ultron internal frontend",
      "onAutoForward": "ignore"
    },
    "8000": {
      "label": "Ultron internal backend",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash .devcontainer/codespaces_prepare.sh",
  "postStartCommand": "nohup bash .devcontainer/codespaces_desktop.sh >/tmp/ultron-codespaces-desktop.log 2>&1 &",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
