{
  "name": "Ultron Personal V1 — Codespaces Web Mode",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--init",
    "--shm-size=1g"
  ],
  "overrideCommand": false,
  "remoteUser": "codespace",
  "containerEnv": {
    "ULTRON_CODESPACES_WEB": "1"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Ultron Web Interface",
      "onAutoForward": "openBrowserOnce",
      "protocol": "http",
      "visibility": "private"
    },
    "8000": {
      "label": "Ultron internal backend",
      "onAutoForward": "ignore",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash .devcontainer/codespaces_prepare.sh",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
