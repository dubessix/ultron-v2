# ============================================================================
# ULTRON — Environment Configuration Template
# Copy this file to `.env` and fill in your real keys.
# Placeholder values are treated as not configured; chat reports explicit offline status.
# ============================================================================

# --- AI Providers ------------------------------------------------------------
# Groq (primary chat provider) — https://console.groq.com
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_4=your_groq_api_key_4_here

# Gemini (fallback provider + memory embeddings) — https://aistudio.google.com
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here

# NVIDIA Build (coding-agent provider, free nvapi- key) — https://build.nvidia.com
NVIDIA_API_KEY_1=your_nvidia_api_key_1_here
NVIDIA_API_KEY_2=your_nvidia_api_key_2_here
NVIDIA_API_KEY_3=your_nvidia_api_key_3_here
NVIDIA_API_KEY_4=your_nvidia_api_key_4_here

# --- Security / Environment ---------------------------------------------------
ENV_STATE=production
SECRET_KEY=generate_a_secure_random_key_here

# --- Optional Tools (reported unavailable until real keys are added) ----------
# GitHub (up to 2 NAMED accounts — Ultron knows whose repo it's working on)
# GITHUB_USERNAME_<n> tells Ultron which account owns the repo; it uses GITHUB_TOKEN_<n>.
GITHUB_USERNAME_1=your_github_username_1
GITHUB_TOKEN_1=your_github_personal_access_token_here
GITHUB_USERNAME_2=your_second_github_username_2
GITHUB_TOKEN_2=your_second_github_personal_access_token_here
TAVILY_API_KEY=your_tavily_api_key_here

# --- Frontend (optional; default http://127.0.0.1:8000) ------------------------
VITE_API_URL=http://127.0.0.1:8000
# Voice wake-word recognition language (default en-IN — mixed English/Hinglish
# commands). Set to e.g. hi-IN for Hindi-first, or bn-IN for Bengali.
VITE_VOICE_LANG=en-IN
